# ══════════════════════════════════════════════════════════════════════════
# GOLDBOT (Bot-v10) — .env.example
# Copy to .env and fill in real credentials. NEVER commit .env.
# ══════════════════════════════════════════════════════════════════════════

# ── DELTA EXCHANGE ──────────────────────────────────────────────────────────
DELTA_API_KEY=YOUR_DELTA_API_KEY
DELTA_API_SECRET=YOUR_DELTA_API_SECRET
DELTA_TESTNET=false
PAPER_TRADING=true
PAPER_TRADING_BALANCE=2000.0

# ── INSTRUMENT — set these two lines to switch between BTC and Gold ────────
# BTC:  SYMBOL=BTC/USD:USD        BASE_ASSET_LABEL=BTC
# GOLD: SYMBOL=PAXG/USD:USD       BASE_ASSET_LABEL=PAXG
#       (confirm PAXG/USD:USD is the exact ccxt symbol Delta India lists —
#       check via exchange.load_markets() if unsure before going live)
SYMBOL=PAXG/USD:USD
BASE_ASSET_LABEL=PAXG
ALERT_QTY=1
# 0 = auto-detect contract_value from exchange market metadata (recommended).
# Only set a nonzero override if you need to force a value.
CONTRACT_VALUE_OVERRIDE=0

# ── POSITION SIZING — GOLDBOT dynamic risk-based qty ────────────────────────
# static = fixed size from POSITION_BTC_SIZE (legacy, BTC-bot behavior)
# risk   = qty computed fresh every signal from live equity × RISK_PCT_PER_TRADE
POSITION_SIZE_MODE=risk
RISK_PCT_PER_TRADE=1.0
MIN_QTY_LOTS=1
MAX_QTY_LOTS=0
# Only used when POSITION_SIZE_MODE=static
POSITION_BTC_SIZE=0.033

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── TIMEFRAME ────────────────────────────────────────────────────────────────
CANDLE_TIMEFRAME=15m

# ── INDICATOR LENGTHS — user-requested EMA 60/20, all now .env-controlled ───
EMA_TREND_LEN=60
EMA_FAST_LEN=50
ATR_LEN=14
DI_LEN=14
ADX_SMOOTH=14
ADX_EMA=5
RSI_LEN=14

FILTER_ATR_MULT=1.4
FILTER_BODY_MULT=0.5
FILTER_BODY_ENABLED=true
FILTER_BODY_TOLERANCE=0.0
FILTER_VOL_MULT=1.0
FILTER_VOL_ENABLED=true

ADX_TREND_TH=22
ADX_RANGE_TH=18
ADX_TOLERANCE=0.0

TREND_RR=4.0
RANGE_RR=2.5
TREND_ATR_MULT=0.6
RANGE_ATR_MULT=0.5
MAX_SL_MULT=1.5
MAX_SL_POINTS=500
BE_MULT=0.6
BRACKET_SL_BUFFER=10.0
RSI_OB=70
RSI_OS=30
PINE_MINTICK=1.0

BREAKOUT_BUFFER_PTS=0
COMMISSION_PCT_BPS=5

# ── TRAIL ENGINE ─────────────────────────────────────────────────────────────
TRAIL_LOOP_SEC=2.0
TRAIL_SL_CONFIRM_TICKS=5
TRAIL_SL_BREACH_HOLD_SECS=9.0
TRAIL_SL_PRE_FIRE_BUFFER=0
TRAIL_OFFSET_FLOOR_MULT=0.15
TRAIL_ARM_FLOOR_MULT=0.0
TRAIL_SL_CONFIRM_TICKS=2
SL_CONFIRM_TICKS=5
SL_CONFIRM_MS=1500
BAR_CLOSE_SL_EVAL=true
TP_HARD_EXIT=false
SL_FIRE_VIA_BRACKET=false
TRAIL_EXIT_FROM_DELTA_WS=false
TRAIL_FIRE_SL_ON_CANDLE_EXTREME=false
# GOLDBOT — user-requested: stage upgrade + BE evaluated on the running
# (unclosed) candle. Set to bar_close for Pine-exact timing instead.
TRAIL_STAGE_UPGRADE_MODE=intrabar

TIME_EXIT_MINUTES=0
WS_RECONNECT_SEC=5

USE_BINANCE_FEED=true
BINANCE_SIGNAL_FEED=false
BINANCE_SYMBOL=PAXG/USDT

MAX_EXIT_SLIPPAGE_ATR_PCT=25.0

LOG_FILE=/root/Bot-v10/journal.db
PORT=10000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=9000
DASHBOARD_USER=admin
DASHBOARD_PASS=YOUR_DASHBOARD_PASSWORD
CLIENT_DASHBOARD_PORT=8081

TURSO_URL=libsql://YOUR_DB_NAME.aws-ap-south-1.turso.io
TURSO_TOKEN=YOUR_TURSO_TOKEN

GSHEET_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GSHEET_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SA@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
