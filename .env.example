# ══════════════════════════════════════════════════════════════════════════
# GOLDBOT — Environment Configuration (.env)
# ══════════════════════════════════════════════════════════════════════════

# ── DELTA EXCHANGE API CREDENTIALS ─────────────────────────────────────────
DELTA_API_KEY=YOUR_DELTA_API_KEY
DELTA_API_SECRET=YOUR_DELTA_API_SECRET
DELTA_TESTNET=false

# ── PAPER TRADING (SIMULATION MODE) ────────────────────────────────────────
# Set PAPER_TRADING=true to run simulated trades using real live data feeds.
# Zero financial risk — blocks all order placement on Delta Exchange account.
PAPER_TRADING=true
PAPER_TRADING_BALANCE=2000.0

# ── INSTRUMENT — PAXG GOLD ────────────────────────────────────────────────
SYMBOL=PAXG/USD:USD
BASE_ASSET_LABEL=PAXG
ALERT_QTY=1
CONTRACT_VALUE_OVERRIDE=0

# ── POSITION SIZING — 1.0% RISK DYNAMIC ────────────────────────────────────
POSITION_SIZE_MODE=risk
RISK_PCT_PER_TRADE=1.0
MIN_QTY_LOTS=1
MAX_QTY_LOTS=0
POSITION_BTC_SIZE=0.033

# ── NOTIFICATIONS ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── TIMEFRAME — 15m ────────────────────────────────────────────────────────
CANDLE_TIMEFRAME=15m

# ── INDICATOR LENGTHS — EMA 50 / 60 ────────────────────────────────────────
EMA_TREND_LEN=60
EMA_FAST_LEN=50
ATR_LEN=14
DI_LEN=14
ADX_SMOOTH=14
ADX_EMA=5
RSI_LEN=14

# ── ENTRY FILTERS ──────────────────────────────────────────────────────────
FILTER_ATR_MULT=1.4
FILTER_BODY_MULT=0.5
FILTER_BODY_ENABLED=true
FILTER_BODY_TOLERANCE=0.0
FILTER_VOL_MULT=1.0
FILTER_VOL_ENABLED=true
ADX_TREND_TH=22
ADX_RANGE_TH=18
ADX_TOLERANCE=0.0

# ── RISK & REWARD ──────────────────────────────────────────────────────────
TREND_RR=4.0
RANGE_RR=2.5
TREND_ATR_MULT=0.6
RANGE_ATR_MULT=0.5
MAX_SL_MULT=1.5
MAX_SL_POINTS=500
BE_MULT=0.6
BRACKET_SL_BUFFER=10.0
RSI_OB=70
RSI_OS=30
PINE_MINTICK=1.0

BREAKOUT_BUFFER_PTS=0
COMMISSION_PCT_BPS=5

# ── TRAILING ENGINE & WICK GUARDS ──────────────────────────────────────────
TRAIL_LOOP_SEC=2.0
SL_CONFIRM_TICKS=5
TRAIL_SL_CONFIRM_TICKS=5
TRAIL_SL_BREACH_HOLD_SECS=9.0
TRAIL_SL_PRE_FIRE_BUFFER=0
TRAIL_OFFSET_FLOOR_MULT=0.15
TRAIL_ARM_FLOOR_MULT=0.0
SL_CONFIRM_MS=1500
BAR_CLOSE_SL_EVAL=true
TP_HARD_EXIT=false
SL_FIRE_VIA_BRACKET=false
TRAIL_EXIT_FROM_DELTA_WS=false
TRAIL_FIRE_SL_ON_CANDLE_EXTREME=false

# Stage upgrades & BE evaluated inside running candle (intrabar)
TRAIL_STAGE_UPGRADE_MODE=intrabar

TIME_EXIT_MINUTES=0
WS_RECONNECT_SEC=5

USE_BINANCE_FEED=true
BINANCE_SIGNAL_FEED=false
BINANCE_SYMBOL=PAXG/USDT

MAX_EXIT_SLIPPAGE_ATR_PCT=25.0

# ── PATHS & DASHBOARD SERVER ───────────────────────────────────────────────
LOG_FILE=/app/goldbot/journal.db
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=10001
DASHBOARD_USER=admin
DASHBOARD_PASS=YOUR_DASHBOARD_PASSWORD
