[Unit]
Description=Shiva Sniper Gold Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/app/goldbot
EnvironmentFile=/app/goldbot/.env
ExecStart=/usr/bin/python3 /app/goldbot/main.py

# Restart on crash — wait 10s between restarts
Restart=on-failure
RestartSec=10s

# Output to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goldbot

# Resource limits
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
